function arrumarDrive() {
  // trava: impede que um lote manual e um gatilho rodem ao mesmo tempo (e dupliquem)
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) { Logger.log('Outra execução em andamento; saindo.'); return; }

  const inicio = Date.now();
  const props = PropertiesService.getScriptProperties();
  const flat = _flatten_();
  let cursor = parseInt(props.getProperty('cursor') || '0', 10);
  const sheet = _getReportSheet_(props);
  const cache = {};
  let buffer = [];
  let feitos = 0;
  let concluiu = false;

  try {
    if (cursor === 0) {
      sheet.appendRow(['--- RUN ' + new Date().toLocaleString('pt-BR') +
        (CONFIG.DRY_RUN ? '  [ENSAIO / DRY-RUN]' : '  [MOVENDO DE VERDADE]') +
        '  total=' + flat.length + ' ---']);
    }

    for (; cursor < flat.length; cursor++) {
      // orçamento de tempo: para ANTES do limite de 6 min do Apps Script e deixa o gatilho seguir
      if (Date.now() - inicio > CONFIG.TIME_BUDGET_MS || feitos >= CONFIG.MAX_POR_EXECUCAO) break;

      const tipo = flat[cursor][0], id = flat[cursor][1], destino = flat[cursor][2];
      let nome = '(?)', status = '', obs = '';
      try {
        const item = (tipo === 'pasta') ? DriveApp.getFolderById(id) : DriveApp.getFileById(id);
        nome = item.getName();
        const destFolder = _getOrCreateByPath_(CONFIG.PROJECT_ROOT_ID, destino, cache);
        let jaOk = false;
        const ps = item.getParents();
        while (ps.hasNext()) { if (ps.next().getId() === destFolder.getId()) { jaOk = true; break; } }
        if (jaOk) status = 'JA_OK';
        else if (CONFIG.DRY_RUN) status = 'PLANEJADO';
        else { item.moveTo(destFolder); status = (tipo === 'pasta') ? 'PASTA_MOVIDA' : 'MOVIDO'; }
      } catch (e) { status = 'ERRO'; obs = String(e).slice(0, 200); }
      buffer.push([tipo, id, nome, destino, status, obs]);
      feitos++;

      // grava em blocos e salva o cursor -> se a execução cair, retoma exatamente daqui
      if (buffer.length >= CONFIG.FLUSH_CADA) {
        sheet.getRange(sheet.getLastRow() + 1, 1, buffer.length, 6).setValues(buffer);
        buffer = [];
        props.setProperty('cursor', String(cursor + 1));
      }
    }

    if (buffer.length) sheet.getRange(sheet.getLastRow() + 1, 1, buffer.length, 6).setValues(buffer);
    props.setProperty('cursor', String(cursor));
    concluiu = (cursor >= flat.length);

    Logger.log('Lote: %s | restam %s | total %s', feitos, flat.length - cursor, flat.length);
    Logger.log('Relatório: %s', sheet.getParent().getUrl());

    if (concluiu) {
      _limparGatilhos_(); props.deleteProperty('cursor');
      sheet.appendRow(['=== FIM. ' + flat.length + ' itens. ===']);
      Logger.log('CONCLUÍDO. Relatório: %s', sheet.getParent().getUrl());
    }
  } finally {
    lock.releaseLock();
    // à prova de falha: se NÃO terminou, reagenda SEMPRE (mesmo que algo acima tenha estourado)
    if (!concluiu && CONFIG.AUTO_CONTINUAR) { _agendarContinuacao_(); Logger.log('Continua em ~1 min...'); }
  }
}

function resetProgresso() {
  const props = PropertiesService.getScriptProperties();
  props.deleteProperty('cursor'); props.deleteProperty('reportId');
  _limparGatilhos_(); Logger.log('Reiniciado. Próxima execução começa do zero.');
}

function _flatten_() {
  const out = [];
  Object.keys(PLAN_FOLDERS).forEach(function (d) { PLAN_FOLDERS[d].forEach(function (id) { out.push(['pasta', id, d]); }); });
  Object.keys(PLAN_FILES).forEach(function (d) { PLAN_FILES[d].forEach(function (id) { out.push(['arquivo', id, d]); }); });
  return out;
}

function _getOrCreateByPath_(rootId, path, cache) {
  if (cache[path]) return cache[path];
  const FIX = CONFIG.FOLDER_IDS || {};
  // 1) destino inteiro com ID fixo conhecido -> usa direto (cobre nomes com "/" no título)
  if (FIX[path]) { const f = DriveApp.getFolderById(FIX[path]); cache[path] = f; return f; }
  // 2) resolve por caminho; ancora cada segmento que tiver ID fixo (1º nível costuma ter)
  let folder = DriveApp.getFolderById(rootId);
  path.split('/').forEach(function (seg) {
    seg = seg.trim();
    if (FIX[seg]) { folder = DriveApp.getFolderById(FIX[seg]); return; }
    const it = folder.getFoldersByName(seg);
    folder = it.hasNext() ? it.next() : folder.createFolder(seg);
  });
  cache[path] = folder; return folder;
}

function _getReportSheet_(props) {
  let id = props.getProperty('reportId');
  if (id) { try { return SpreadsheetApp.openById(id).getSheets()[0]; } catch (e) {} }
  const ss = SpreadsheetApp.create('Arrumacao Potencial Urbano FINAL — ' + new Date().toISOString().slice(0, 16));
  const sh = ss.getSheets()[0];
  sh.appendRow(['tipo', 'id', 'nome', 'destino', 'status', 'obs']); sh.setFrozenRows(1);
  props.setProperty('reportId', ss.getId()); return sh;
}

function _agendarContinuacao_() { _limparGatilhos_(); ScriptApp.newTrigger('arrumarDrive').timeBased().after(60 * 1000).create(); }
function _limparGatilhos_() { ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'arrumarDrive') ScriptApp.deleteTrigger(t); }); }
